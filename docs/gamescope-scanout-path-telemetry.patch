+
+// Optional diagnostics: export the *actual DRM Present path*, not a Wayland
+// ZERO_COPY hint. Only publishes when the path changes to avoid per-frame X11
+// activity and to avoid disturbing the rendering timing being measured.
+void steamcompmgr_report_scanout_path(uint32_t path)
+{
+	static uint32_t lastPath = 0;
+	if (path == lastPath)
+		return;
+
+	gamescope_xwayland_server_t *server = wlserver_get_xwayland_server(0);
+	if (!server || !server->ctx || !server->ctx->dpy)
+		return;
+	xwayland_ctx_t *ctx = server->ctx.get();
+
+	Atom atom = XInternAtom(ctx->dpy, "GAMESCOPE_MOONLIGHT_SCANOUT_PATH", False);
+	unsigned long value = path; // Xlib expects long storage for format=32.
+	XChangeProperty(ctx->dpy, ctx->root, atom, XA_CARDINAL, 32, PropModeReplace,
+	                reinterpret_cast<const unsigned char*>(&value), 1);
+	XFlush(ctx->dpy);
+	lastPath = path;
+}
 

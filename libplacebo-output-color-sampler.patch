+static ident_t hook_find_sampled_texture(pl_shader sh, pl_tex tex)
+{
+    for (int i = 0; i < sh->descs.num; i++) {
+        const struct pl_shader_desc *desc = &sh->descs.elem[i];
+        if (desc->desc.type == PL_DESC_SAMPLED_TEX &&
+            desc->binding.object == tex)
+        {
+            return sh_ident_unpack(desc->desc.name);
+        }
+    }
+
+    return NULL_IDENT;
+}
